# ── App ───────────────────────────────────────────────────────────────
APP_NAME=MarketMind AI
DEBUG=True
SECRET_KEY=change-this-to-a-random-string-in-production

# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Make sure PostgreSQL is running: sudo service postgresql start
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/marketmind

# ── Redis (for caching) ───────────────────────────────────────────────
# Make sure Redis is running: sudo service redis start
REDIS_URL=redis://localhost:6379

# ── AI (REQUIRED for chat feature) ────────────────────────────────────
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Market Data ───────────────────────────────────────────────────────
# Set to True to fetch real NSE data via yfinance (needs internet)
USE_LIVE_DATA=False

# Optional: For higher rate limits on market data
TWELVEDATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── Video Generation ──────────────────────────────────────────────────
VIDEO_OUTPUT_DIR=./generated_videos
# Make sure ffmpeg is installed: sudo apt install ffmpeg
FFMPEG_PATH=ffmpeg
